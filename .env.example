# Copy to .env or export variables in your shell. Never commit .env.
# SAST_REF is the Sebastian repository commit used by the container build.
SAST_REF=074ddfc409bdd120c93a0b68773bafa464e56504

# Optional alternative to the browser Model settings panel.
# Keys entered in the UI need no .env changes or service restart.
OPENAIKEY=

# Other optional environment credentials:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=

# Reviewed external SAST source; default shared-context proposal
SAST_REPO=https://github.com/jundahuang9123/profile-requirements-extraction.git
SAST_REF=153b6ca0ff947f05d860addc55e227ab60662a89
